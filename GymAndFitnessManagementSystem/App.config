<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="GymFitnessDb" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=GymFitnessDB;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    <add name="GymFitnessMaster" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
